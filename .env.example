# Telegram bot token from @BotFather
BOT_TOKEN=

# PostgreSQL connection string (Neon), e.g.:
# postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Public base URL of this service (Render assigns one), e.g.:
# https://juz40-tester.onrender.com
WEBHOOK_URL=

# REQUIRED in production: secret token for the Telegram webhook (1-256
# chars of A-Z a-z 0-9 _ -). Updates without the matching
# X-Telegram-Bot-Api-Secret-Token header are rejected with 403. The bot
# refuses to start without it unless APP_ENV=development (or dev/local/test).
WEBHOOK_SECRET=
# APP_ENV=development

# Optional: DIRECT (non-pooler) connection string used only for migrations
# (they rely on a session-level advisory lock, unreliable behind a
# transaction-mode pooler). By default DATABASE_URL is used with a Neon
# "-pooler" host rewritten to the direct endpoint.
# MIGRATION_DATABASE_URL=

# Max connections of the DB pool (default 15).
# DB_MAX_CONNS=20
# UPDATE_TIMEOUT_SEC=60
# TG_MAX_RPS=20
# DB_MIN_CONNS=5
# DB_CONN_MAX_LIFETIME_SEC=1800
# DB_CONN_MAX_IDLE_SEC=300
# CHAIN_CACHE_TTL_SEC=45
# REAPER_INTERVAL_SEC=300
# HEALTH_CACHE_SEC=45

# HTTP port (Render sets it automatically)
PORT=8080

# Groq API (FREE tier) — primary AI provider. Get a key at
# https://console.groq.com/keys
#   * Kazakh translation   -> qwen/qwen3.8-27b    (instruct mode, fast)
#   * test generation      -> openai/gpt-oss-120b (reasoning medium/low)
# DeepSeek below becomes the paid fallback only. Free-tier limits per model:
# 30 RPM, 1000 RPD, 8000 TPM (= max size of ONE request), 200000 TPD — the
# bot enforces them itself (see docs/GROQ_LIMITS.md).
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Only after upgrading to the Groq Developer plan:
# GROQ_RPM=1000
# GROQ_TPM=250000
# GROQ_RPD=
# GROQ_TPD=

# DeepSeek API — PAID fallback for generation and translation (the primary
# provider when GROQ_API_KEY is not set). Without any AI key the bot has no
# tests to serve. Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Primary generation model (default: deepseek-flash = DeepSeek-V4.1-Flash).
# It is ALWAYS called in thinking mode ({"thinking":{"type":"enabled"}} +
# reasoning_effort): effort=high for shared chain tests, effort=low for
# personal weak-topics tests and retries. One 20-question test costs
# roughly $0.002–0.006 (hard ceiling ~$0.0096 via max_tokens=8000).
# NOTE: the legacy names deepseek-chat / deepseek-reasoner were removed
# from the API on 2026-07-24 — do NOT set them here.
DEEPSEEK_REASONER_MODEL=deepseek-flash

# Fallback non-thinking model, used only if the thinking parameters are
# rejected by a proxy (default: deepseek-v4-pro). Pricier than flash —
# it must stay a fallback, never the primary.
DEEPSEEK_MODEL=deepseek-v4-pro

# API endpoint override (usually not needed)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Off-peak generation window. By default the OFFICIAL DeepSeek schedule is
# used (peak = 01:00-04:00 and 06:00-10:00 UTC on weekdays; nights,
# evenings and weekends are half price). Pre-generation of LOCKED chain
# tests runs only in off-peak hours. Tests the user can already open, and
# personal weak-topics tests, are URGENT and run immediately at any hour.
# Set BOTH variables (server-local hours) only to override with a custom
# window (e.g. a proxy with a different discount schedule):
# GEN_OFFPEAK_START_HOUR=1
# GEN_OFFPEAK_END_HOUR=6

# --- Abuse limits & spending cap (R-9) ---
# Minimum gap between two actions (taps/messages) of one user, ms (0 = off).
# In-memory per instance unless RATELIMIT_BACKEND=redis (then shared).
# USER_ACTION_INTERVAL_MS=300
# New personal weak-topics generations per user per day (0 = no limit).
# Clones of an already generated test are free and not counted. DB-backed.
# PERSONAL_GEN_PER_USER_DAY=3
# Global daily DeepSeek spending cap in USD, UTC day (0 = NO cap). Fed by the
# client's per-call cost estimate, stored in ai_spend_daily (DB-backed, holds
# across instances). When reached, no paid DeepSeek call is sent: generation
# jobs wait for free Groq quota or the next day.
# DEEPSEEK_DAILY_CAP_USD=2.0

# --- Generation at scale (see README «Масштабирование генерации») ---
# GEN_STRATEGY=batch            # batch | full | ab
# GEN_AB_BATCH_PERCENT=50
# GEN_BATCH_SIZE=5
# GEN_BATCH_PARALLEL=2
# GEN_MAX_ACTIVE_PERSONAL=300   # 0 = no backpressure
# GEN_TEMPLATE_REUSE=true       # clone tests by weak-topics fingerprint
# GEN_PREGEN_AHEAD=0            # 1 = pre-generate chain test N+2 off-peak
# METRICS_TOKEN=                # protects GET /metrics
# DB_CONN_MAX_LIFETIME=30m      # alias of DB_CONN_MAX_LIFETIME_SEC
# DB_CONN_MAX_IDLE_TIME=5m      # alias of DB_CONN_MAX_IDLE_SEC

# --- Cluster mode: web + N workers (see docs/CLUSTER.md) ---
# ROLE=all                      # all | web | worker (all = everything in one process)
# QUEUE_BACKEND=                # memory (default for all) | postgres (default for web/worker) | redis
# RATELIMIT_BACKEND=            # memory (default for all) | postgres (default for web/worker) | redis
# CACHE_BACKEND=memory          # memory | redis
# REDIS_URL=                    # empty = Redis is never used
# REDIS_PREFIX=juz40
# INSTANCE_ID=                  # default hostname-pid
# UPDATE_WORKERS=               # default DB_MAX_CONNS - background reserve (<= 32)
# UPDATE_QUEUE_MAX=20000        # backpressure: 503 above this backlog (0 = no limit)
# UPDATE_MAX_ATTEMPTS=3         # then the update goes to the dead letters
# UPDATE_LEASE_SEC=45           # a dead worker's update is re-queued after this
# UPDATE_DONE_TTL_HOURS=48      # idempotency window (min 25)
# UPDATE_DEAD_TTL_DAYS=14

# --- Telegram Stars subscriptions (see docs/SUBSCRIPTIONS.md) ---
# SUBSCRIPTIONS_ENABLED=1       # 0 = no daily quota, free weak-topics tests (old behaviour)
# QUOTA_TZ=Asia/Almaty          # the daily limit resets at local midnight
# PLAN_FREE_DAILY=1
# PLAN_PLUS_PRICE=10            # Stars per 30 days (0 = plan switched off)
# PLAN_PLUS_DAILY=4
# PLAN_PRO_PRICE=40
# PLAN_PRO_DAILY=10
# PLAN_PREMIUM_PRICE=50
# PLAN_PREMIUM_DAILY=20
# WEAK_TEST_PRICE_STARS=10      # one weak-topics test (0 = free, old flow)
# SUB_GRACE_MIN=60              # a paid plan stays active this long after expiry
# ADMIN_IDS=                    # Telegram ids: /grant /revoke /subinfo /refund
# WEAK_ORDER_TIMEOUT_MIN=45     # paid order without a test -> automatic refund
# WEAK_ORDER_MAX_GEN=3          # generation attempts per paid order
# BILLING_RECONCILE_SEC=60
# TELEGRAM_TEST_ENV=0           # 1 = Telegram test environment (test Stars)
# TELEGRAM_API_URL=             # another Bot API server (local)
