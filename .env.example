# Telegram bot token from @BotFather
BOT_TOKEN=

# PostgreSQL connection string (Neon), e.g.:
# postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Public base URL of this service (Render assigns one), e.g.:
# https://juz40-tester.onrender.com
WEBHOOK_URL=

# HTTP port (Render sets it automatically)
PORT=8080

# DeepSeek API — AI test generation. Without a key the bot has no tests to
# serve (the chain is built by the generator). Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Primary generation model (default: deepseek-flash = DeepSeek-V4.1-Flash).
# It is ALWAYS called in thinking mode ({"thinking":{"type":"enabled"}} +
# reasoning_effort): effort=high for shared chain tests, effort=low for
# personal weak-topics tests and retries. One 20-question test costs
# roughly $0.002–0.006 (hard ceiling ~$0.0096 via max_tokens=8000).
# NOTE: the legacy names deepseek-chat / deepseek-reasoner were removed
# from the API on 2026-07-24 — do NOT set them here.
DEEPSEEK_REASONER_MODEL=deepseek-flash

# Fallback non-thinking model, used only if the thinking parameters are
# rejected by a proxy (default: deepseek-v4-pro). Pricier than flash —
# it must stay a fallback, never the primary.
DEEPSEEK_MODEL=deepseek-v4-pro

# API endpoint override (usually not needed)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Off-peak generation window. By default the OFFICIAL DeepSeek schedule is
# used (peak = 01:00-04:00 and 06:00-10:00 UTC on weekdays; nights,
# evenings and weekends are half price). Pre-generation of LOCKED chain
# tests runs only in off-peak hours. Tests the user can already open, and
# personal weak-topics tests, are URGENT and run immediately at any hour.
# Set BOTH variables (server-local hours) only to override with a custom
# window (e.g. a proxy with a different discount schedule):
# GEN_OFFPEAK_START_HOUR=1
# GEN_OFFPEAK_END_HOUR=6
